{
  "expo": {
    "name": "Barcode Tracker",
    "slug": "barcode-tracker",
    "scheme": "barcodetracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app requiere acceso a la cámara para escanear códigos de barras de productos en tienda.",
        "NSPhotoLibraryUsageDescription": "Esta app requiere acceso a la galería para detectar códigos de barras en fotografías guardadas."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.javi_1499.barcodetracker"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite escanear códigos de barras de productos físicos en tiendas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite seleccionar fotos de etiquetas para extraer códigos de barras."
        }
      ],
      "expo-web-browser",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "7d13f6be-853b-42d9-bc05-16f9d5c286f8"
      }
    }
  }
}
